#!/usr/bin/env node
// yt-dlp falso do Clipora (fixture de teste). Ver tests/fixtures/README.md.
const { join } = require('node:path');
const { pathToFileURL } = require('node:url');
import(pathToFileURL(join(__dirname, '..', 'lib', 'ytdlp-falso.mjs')).href)
  .then((m) => m.principal(process.argv.slice(2)))
  .catch((e) => { process.stderr.write(`yt-dlp falso: ${e && e.stack ? e.stack : e}\n`); process.exitCode = 70; });
